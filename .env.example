# Flask environment (development, production, testing)
FLASK_ENV=development

# Enable/disable Flask debug mode (true/false)
FLASK_DEBUG=true

# Secret key used for session signing and CSRF protection
# Replace this with a strong, random value in production
SECRET_KEY=your-secret-key-here

# Database connection URL (SQLAlchemy format)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Example for SQLite (development): sqlite:///instance/app.db
DATABASE_URL=sqlite:///instance/app.db

# Optional: Port on which the Flask app will run (default 5000)
# PORT=5000

# Optional: Host for the Flask app (default 0.0.0.0)
# HOST=0.0.0.0