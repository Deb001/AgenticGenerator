# Flask application entry point
FLASK_APP=src/app.py

# Environment mode: development, production, or testing
FLASK_ENV=development

# Secret key used for session management and CSRF protection.
# Replace with a strong, random value in production.
SECRET_KEY=change-me-to-a-strong-secret

# Database connection URL (example uses SQLite for local development)
DATABASE_URL=sqlite:///instance/app.db

# Gunicorn configuration (used when running in production)
# Number of worker processes; adjust based on CPU cores.
GUNICORN_WORKERS=2

# Optional: Enable Flask's built‑in debugger (should be false in production)
FLASK_DEBUG=true