# Flask environment (development|production)
FLASK_ENV=development
# Enable debug only in development
FLASK_DEBUG=1
# Secret keys – generate strong random values
SECRET_KEY=replace_this_with_a_secure_random_string
JWT_SECRET=replace_this_with_another_secure_random_string
# Database URL – matches docker-compose service name
DATABASE_URL=postgresql://todo_user:todo_pass@db:5432/todo_db
# Application port (optional)
PORT=5000